Set Shell bash
Set FontFamily "Atkinson Hyperlegible Mono"
Set FontSize 20
Set Width 1280
Set Height 720
Set Padding 32
Set TypingSpeed 35ms
Set WaitPattern /\$$/
Set Theme { "name": "gitbay", "black": "#000000", "red": "#ff6b6b", "green": "#5fd38d", "yellow": "#ffb454", "blue": "#6cb6ff", "magenta": "#d2a8ff", "cyan": "#76e3ea", "white": "#e6e6e6", "brightBlack": "#6e7681", "brightRed": "#ff8e8e", "brightGreen": "#7ee2a8", "brightYellow": "#ffc777", "brightBlue": "#8cc8ff", "brightMagenta": "#e2c5ff", "brightCyan": "#a5f0f5", "brightWhite": "#ffffff", "background": "#0b0b0b", "foreground": "#e6e6e6", "selection": "#333333", "cursor": "#ff8c1a" }

Hide
Type "source docs/demo/env.sh && clear" Enter
Sleep 1s
Show
